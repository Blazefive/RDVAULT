{
  "appId": "com.groupeprofessionsante.rdvault",
  "productName": "RDVAULT",
  "icon": "assets/icon.ico",
  "directories": {
    "buildResources": "assets",
    "output": "dist"
  },
  "files": [
    "build/**/*",
    "electron/**/*",
    "!electron/**/*.test.js",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "assets/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "assets/shortcut-icon.ico",
      "to": "shortcut-icon.ico"
    },
    {
      "from": "config.default.json",
      "to": "config.default.json"
    },
    {
      "from": "chrome-rbi",
      "to": "chrome-rbi",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "cli",
      "to": "cli",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "chrome-extension/vault-autofill-extension",
      "to": "chrome-extension",
      "filter": [
        "**/*",
        "!**/*.md"
      ]
    }
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "protocols": [
    {
      "name": "RDVAULT Share",
      "schemes": [
        "rdvault"
      ]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "Blazefive",
      "repo": "RDVAULT"
    }
  ],
  "afterPack": "./scripts/afterPack.js",
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "signAndEditExecutable": true,
    "legalTrademarks": "Blazefive"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": false,
    "shortcutName": "RDVAULT",
    "include": "assets/installer.nsh",
    "perMachine": true,
    "allowElevation": true,
    "warningsAsErrors": false
  }
}
